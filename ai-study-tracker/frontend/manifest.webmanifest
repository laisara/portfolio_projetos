{
  "name": "AI Engineer Study Tracker",
  "short_name": "Study Tracker",
  "description": "Ambiente pessoal de estudos de IA: aulas, prática, projetos e revisão.",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0a0d0c",
  "theme_color": "#0a0d0c",
  "lang": "pt-BR",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Estudar agora",
      "url": "/#/",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Revisões",
      "url": "/#/reviews"
    },
    {
      "name": "Cronograma",
      "url": "/#/calendar"
    }
  ]
}