{
  "name": "AI Engineer Study Tracker",
  "short_name": "Study Tracker",
  "description": "Controle pessoal de estudos da formação: trilhas, módulos, aulas, cronograma e revisões.",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "landscape-primary",
  "background_color": "#0a0d0c",
  "theme_color": "#0a0d0c",
  "lang": "pt-BR",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Iniciar sessão",
      "url": "/#/focus",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Calendário",
      "url": "/#/calendar"
    },
    {
      "name": "Formação",
      "url": "/#/catalog"
    }
  ]
}